# source version: 0.0.0

# Print the entries of `$values` that start with `$prefix`, each carrying
# `$leader`: the `--opt=` of a `--opt=value` word, and empty otherwise.
fn tsed-values {|values prefix leader|
    put $@values | each {|x| if (str:has-prefix $x $prefix) { put $leader$x } }
}

# Print the option tokens from `$pool` that match `$cur` and have not been
# given yet, unless they may be repeated (docs/spec §9.1 rule 5).
fn tsed-options {|pool cur seen repeatable|
    put $@pool | each {|x|
        if (and (str:has-prefix $x $cur) (or (has-value $repeatable $x) (not (has-value $seen $x)))) {
            put $x
        }
    }
}

use str

set edit:completion:arg-completer[tsed] = {|@words|
    var cur = $words[-1]
    var prev = (if (> (count $words) 2) { put $words[-2] } else { put '' })
    # Everything before the word being completed.
    var words-before = [(take (- (count $words) 1) $words)]

    # `--opt=value` arrives as one word; split it so that the option and the
    # value prefix are separate. `leader` puts the option back in front of a
    # match, because elvish replaces the whole word with the candidate.
    var opt = $prev
    var prefix = $cur
    var leader = ''
    if (str:has-prefix $cur '-') {
        var parts = [(str:split '=' $cur)]
        if (> (count $parts) 1) {
            set opt = $parts[0]
            set prefix = (str:join '=' [(drop 1 $parts)])
            set leader = $opt'='
        }
    }

    # The subcommand, read from the words that are already complete. Hidden
    # commands are still accepted by the CLI, so they still have a context.
    var sub = ''

    # Option tokens already on the line: an option is not offered again
    # unless it may be repeated (docs/spec §9.1 rule 5). `--opt=value` counts
    # as `--opt`.
    var seen = []
    for w $words-before {
        if (str:has-prefix $w '-') {
            var pieces = [(str:split '=' $w)]
            set seen = (conj $seen $pieces[0])
        }
    }

    # What the root offers (docs/spec §9.1); a commandless CLI has no
    # subcommand contexts, so the empty key is the only one.
    var pool-map = [
        &''= ['--protocol-format' '--write' '--dry-run' '--diff' '--directory' '-C' '--read' '--unify' '--unify-min-lines' '--select' '--select-file' '--in' '--rev' '--kind' '--resolve' '--match' '--pick' '--pick-before' '--pick-after' '--within' '--replace-file' '--rename' '--create' '--delete' '--rewrite' '--content-file' '--help' '-h' '--version' '-V']
    ]
    var valuetaking-map = [
        &''= ['--protocol-format' '--directory' '-C' '--read' '--unify' '--unify-min-lines' '--select' '--select-file' '--in' '--rev' '--kind' '--resolve' '--match' '--pick' '--pick-before' '--pick-after' '--within' '--replace-file' '--rename' '--create' '--delete' '--rewrite' '--content-file']
    ]
    var repeatable-map = [
        &''= ['--read' '--unify' '--create' '--delete' '--help' '-h' '--version' '-V']
    ]
    var pool = []
    var valuetaking = []
    var repeatable = []
    if (has-key $pool-map $sub) {
        set pool = $pool-map[$sub]
        set valuetaking = $valuetaking-map[$sub]
        set repeatable = $repeatable-map[$sub]
    }
    # Value candidates, keyed on the option token; an option inherited from
    # `cli.args` needs no command key because it is accepted everywhere, and
    # one declared by a command is keyed on `<command>|<token>` because the
    # same token may mean different things in different commands.
    var value-map = [
        &'|--protocol-format'= ['flag' 'dsl' 'json']
        &'|--resolve'= ['value' 'type' 'namespace']
    ]
    var values = []
    var key = (str:join '|' [$sub $opt])
    if (has-key $value-map $opt) {
        set values = $value-map[$opt]
    } elif (has-key $value-map $key) {
        set values = $value-map[$key]
    }
    var value-position = (or (not (eq $leader '')) (has-value $valuetaking $opt))
    # The positional slot the cursor sits in: every non-option word after the
    # command counts, while an option and the value it consumes do not
    # (docs/spec §9.1 rules 2 and 4).
    var slot = 0
    var next = $false
    var noopts = $false
    # The first word is the CLI name; the root counts from its arguments.
    var started = $false
    for w $words-before {
        if (not $started) {
            set started = $true
            continue
        }
        if $next {
            set next = $false
            continue
        }
        if (not $noopts) {
            if (eq $w '--') {
                set noopts = $true
                continue
            }
            if (str:has-prefix $w '-') {
                if (and (not (str:contains $w '=')) (has-value $valuetaking $w)) {
                    set next = $true
                }
                continue
            }
        }
        set slot = (+ $slot 1)
    }
    var slot-map = [
    ]
    var slot-key = (str:join '|' [$sub (to-string $slot)])
    var slot-candidates = []
    if (has-key $slot-map $slot-key) {
        set slot-candidates = $slot-map[$slot-key]
    }
    var names-position = $false

    # Exactly one branch prints (docs/spec §9.1). After `--` no word is an
    # option, so the value and option branches are gated and a `-`-prefixed
    # word falls through to the positional branch. A word that is completing
    # an option's value is answered by that option's candidates or by nothing
    # at all, never by the option list.
    if (and (not $noopts) $value-position) {
        tsed-values $values $prefix $leader
    } elif (and (not $noopts) (str:has-prefix $cur '-')) {
        tsed-options $pool $cur $seen $repeatable
    } elif (> (count $slot-candidates) 0) {
        tsed-values $slot-candidates $cur ''
    }
}
