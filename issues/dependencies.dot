// Generated by issue; do not edit.
// Issue graph (solid parent, dashed deps); statuses and picking order: todo.yaml.

digraph issues {
  rankdir=LR;
  node [shape=box, style=rounded, fontname="Helvetica"];

  "1"  [label="#1 Implement the editing-protocol deltas from human/edit.md"];
  "2"  [label="#2 Parse and serialize the resolve header and six-tick fences"];
  "3"  [label="#3 Resolve the compact address by TS symbol space and apply creation defaults"];
  "4"  [label="#4 Render viewer details as a numbered declaration block with match markers"];
  "5"  [label="#5 Teach and document the resolve protocol end to end"];
  "6"  [label="#6 Close the remaining compact protocol follow-ups"];
  "7"  [label="#7 Record the edit protocol in replay bundles"];
  "8"  [label="#8 Keep a confirmation edit after the last normal exchange"];
  "9"  [label="#9 Make compact retry and decision prompts consistently select-first"];
  "10" [label="#10 Mark matches in the first select viewer's details"];
  "11" [label="#11 Re-baseline the compact benchmark with replay evidence"];
  "12" [label="#12 Fix duplicate-declaration handling in the compact edit protocol"];
  "13" [label="#13 Reject duplicate creates and same-offset zero-width regions in one compact reply"];
  "14" [label="#14 Make duplicate top-level declarations repairable from the model-facing diagnostics"];
  "15" [label="#15 Rename the compact edit format to edit-dsl"];

  // parent edges (parent -> child), solid
  "1" -> "2";
  "1" -> "3";
  "1" -> "4";
  "1" -> "5";
  "6" -> "7";
  "6" -> "8";
  "6" -> "9";
  "6" -> "10";
  "6" -> "11";
  "12" -> "13";
  "12" -> "14";

  // dependency edges (blocker -> blocked), dashed
  "2" -> "3" [style=dashed, label="blocks"];
  "2" -> "4" [style=dashed, label="blocks"];
  "2" -> "5" [style=dashed, label="blocks"];
  "3" -> "5" [style=dashed, label="blocks"];
  "4" -> "5" [style=dashed, label="blocks"];
  "7" -> "11" [style=dashed, label="blocks"];
  "8" -> "11" [style=dashed, label="blocks"];
  "9" -> "11" [style=dashed, label="blocks"];
  "10" -> "11" [style=dashed, label="blocks"];
}
